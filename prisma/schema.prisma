generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model Category {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  icon      String
  badge     String?
  order     Int       @default(0)
  products  Product[]
  createdAt DateTime  @default(now())
}

model Product {
  id                     String        @id @default(cuid())
  name                   String
  slug                   String        @unique
  tagline                String?
  description            String?
  categorySlug           String
  category               Category      @relation(fields: [categorySlug], references: [slug], onDelete: Cascade)
  developer              String?
  thumbnailUrl           String
  bannerUrl              String?
  badgeText              String?
  badgeColor             String?       @default("mint-pop")
  requiresServer         Boolean       @default(false)
  targetInputLabel       String        @default("User ID")
  targetInputPlaceholder String        @default("Masukkan User ID akun")
  serverInputPlaceholder String?       @default("Zone / Server ID")
  instructions           String?
  importantNotice        String?
  warrantyTerms          String?
  additionalNotes        String?
  isPopular              Boolean       @default(false)
  isActive               Boolean       @default(true)
  items                  ProductItem[]
  orders                 Order[]
  reviews                Review[]
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt
}

model ProductItem {
  id              String   @id @default(cuid())
  productId       String
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku             String   @unique
  name            String
  price           Int
  originalPrice   Int?
  supplierPrice   Int?     @default(0)
  discountPercent Int?
  stockStatus     String   @default("AVAILABLE")
  bonusText       String?
  order           Int      @default(0)
  orders          Order[]
  createdAt       DateTime @default(now())

  // Supplier assignment: DIGIFLAZZ, WAROENGKUY, MANUAL
  supplier        String   @default("MANUAL")

  // Account stock vault for instant delivery of manual digital accounts
  accountStocks   AccountStock[]
}

model Order {
  id                   String      @id @default(cuid())
  invoiceNumber        String      @unique
  targetUserId         String
  targetZoneId         String?
  customerEmail        String
  customerPhone        String?
  productId            String
  product              Product     @relation(fields: [productId], references: [id])
  productItemId        String
  productItem          ProductItem @relation(fields: [productItemId], references: [id])
  basePrice            Int
  uniqueCode           Int         @default(0)
  fee                  Int         @default(0)
  totalAmount          Int
  status               String      @default("PENDING")
  qrisString           String?
  paymentMethod        String      @default("QRIS")
  paidAt               DateTime?
  fulfilledAt          DateTime?
  notes                String?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  // Structured additive fields
  supplierRef          String?
  sn                   String?
  supplierStatus       String?
  couponCode           String?
  discountAmount       Int?        @default(0)
  lastPaymentCheckAt   DateTime?
  fulfillmentStartedAt DateTime?
  fulfillmentAttempts  Int?        @default(0)
  fulfillmentError     String?

  @@index([customerEmail])
  @@index([status])
  @@index([createdAt])
  @@index([status, createdAt])
}

model Coupon {
  id                 String    @id @default(cuid())
  code               String    @unique
  type               String    // "percent" or "fixed"
  value              Int
  maxDiscount        Int?
  minSpend           Int?
  totalQuota         Int?
  perUserQuota       Int?
  active             Boolean   @default(true)
  applicableProducts String?   @default("ALL") // "ALL" or JSON string array of product slugs / IDs
  startsAt           DateTime?
  endsAt             DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  actor     String   // username or system
  action    String   // e.g. "update_order_status"
  target    String   // e.g. invoice or entity ID
  summary   String   // brief summary without secrets
  timestamp DateTime @default(now())

  @@index([actor])
  @@index([action])
  @@index([timestamp])
}

model AdminSession {
  id        String    @id @default(cuid())
  username  String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([username])
}

model RateLimit {
  id        String   @id @default(cuid())
  key       String   @unique
  count     Int      @default(0)
  expiresAt DateTime
  updatedAt DateTime  @updatedAt

  @@index([key])
  @@index([expiresAt])
}

model Admin {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String
  name      String   @default("Super Admin")
  role      String   @default("ADMIN") // OWNER, ADMIN, VIEWER
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SystemSetting {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}

model Banner {
  id          String   @id @default(cuid())
  title       String
  subtitle    String?
  imageUrl    String
  linkUrl     String?  @default("/katalog")
  badgeText   String?  @default("PROMO")
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Review {
  id            String   @id @default(cuid())
  invoiceNumber String   @unique
  productId     String
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  customerName  String   @default("Kawan XYZ")
  rating        Int      @default(5)
  comment       String?  @db.Text
  isPublished   Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([productId])
  @@index([isPublished])
}

model WarrantyClaim {
  id            String    @id @default(cuid())
  invoiceNumber String
  customerPhone String
  customerEmail String?
  issueType     String    @default("ITEM_BELUM_MASUK") // "AKUN_LOGIN_GAGAL", "ITEM_BELUM_MASUK", "SALAH_NOMINAL", "RESET_PROFIL", "LAINNYA"
  description   String    @db.Text
  proofImageUrl String?
  status        String    @default("PENDING") // "PENDING", "IN_REVIEW", "RESOLVED", "REJECTED"
  adminNotes    String?   @db.Text
  resolvedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([invoiceNumber])
  @@index([status])
  @@index([createdAt])
}

model MediaAsset {
  id        String   @id @default(cuid())
  fileName  String
  mimeType  String
  size      Int
  data      Bytes
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model AccountStock {
  id            String      @id @default(cuid())
  productItemId String
  productItem   ProductItem @relation(fields: [productItemId], references: [id], onDelete: Cascade)
  credential    String      @db.Text
  isUsed        Boolean     @default(false)
  orderId       String?
  usedAt        DateTime?
  createdAt     DateTime    @default(now())

  @@index([productItemId, isUsed])
  @@index([createdAt])
}

