# ==============================================================================
# XYZPEDIA - ENVIRONMENT CONFIGURATION TEMPLATE
# Salin file ini menjadi .env di lokal atau masukkan variabel ini di dashboard Vercel.
# JANGAN PERNAH MENGISI NILAI RAHASIA KE DALAM FILE INI ATAU MENG-COMMIT NILAI ASLI.
# ==============================================================================

# --- DATABASE (Neon PostgreSQL) ---
# Format URL database PostgreSQL (Transaction pooled connection)
DATABASE_URL="postgresql://user:password@ep-xyz.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"
# Direct / Unpooled URL untuk Prisma Migrate
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-xyz.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# --- DOMAIN & APLIKASI ---
# Domain resmi aplikasi (tanpa slash di akhir)
NEXT_PUBLIC_APP_URL="https://xyzpedia.my.id"
# Nomor WhatsApp resmi CS / Admin (format internasional tanpa +, contoh: 6281234567890)
NEXT_PUBLIC_WHATSAPP_NUMBER=""

# --- KEAMANAN & AUTENTIKASI ADMIN ---
# Secret key untuk menandatangani token sesi admin (HMAC-SHA256, minimal 32 karakter acak)
ADMIN_JWT_SECRET=""
# Master admin credentials (dapat login langsung sebagai role OWNER)
ADMIN_USERNAME=""
ADMIN_PASSWORD=""
# Kunci enkripsi AES-256-GCM (32 bytes base64) untuk melindungi bot token & password SMTP di DB
SETTINGS_ENCRYPTION_KEY=""
# Kunci HMAC untuk token akses riwayat pesanan (magic link)
ORDER_ACCESS_SECRET=""
# Wajibkan 2FA TOTP untuk login admin (true/false)
ADMIN_2FA_REQUIRED="false"

# --- PAYMENT GATEWAY (QiosPay) ---
QIOSPAY_BASE_URL="https://my.qiospay.com/v1"
QIOSPAY_API_KEY=""
QIOSPAY_WEBHOOK_SECRET=""
QIOSPAY_MERCHANT_CODE=""

# --- SUPPLIER H2H (Digiflazz) ---
DIGIFLAZZ_USERNAME=""
DIGIFLAZZ_KEY=""
DIGIFLAZZ_WEBHOOK_SECRET=""
VPS_PROXY_URL=""

# --- SUPPLIER ALTERNATIF (Waroengkuy) ---
WAROENGKUY_BASE_URL="https://waroengkuy.com/api/reseller/v1"
WAROENGKUY_API_KEY=""

# --- CRON & AUTOMATION ---
# Secret token untuk memvalidasi pemanggilan endpoint cron Vercel (Authorization: Bearer <token>)
CRON_SECRET=""

# --- PROXY & NETWORK ---
# Header proxy tepercaya untuk client IP ("cloudflare", "vercel", atau "none")
TRUSTED_PROXY="cloudflare"

# --- VERCEL BLOB STORAGE (Opsional) ---
# Diperlukan untuk upload gambar ke cloud di production
BLOB_READ_WRITE_TOKEN=""

# --- MONITORING (Opsional) ---
SENTRY_DSN=""

# --- STATUS MODE ---
NEXT_PUBLIC_PAYMENT_MAINTENANCE="false"
