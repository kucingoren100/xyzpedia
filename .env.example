# ==============================================================================
# XYZPEDIA - ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Salin file ini menjadi .env lalu isi kredensial API Anda
# ==============================================================================

# Application Setup
NEXT_PUBLIC_APP_NAME="XYZPEDIA"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
DATABASE_URL="file:./dev.db"

# 1. QIOSPAY GATEWAY (Payment Gateway QRIS Dinamis)
QIOSPAY_ENABLED=true
QIOSPAY_BASE_URL="https://my.qiospay.com/v1"
QIOSPAY_MERCHANT_CODE="your_merchant_code_here"
QIOSPAY_API_KEY="qp_live_your_api_key_here"
QIOSPAY_PRIVATE_KEY="whsec_your_private_key_here"
QIOSPAY_CALLBACK_URL="https://xyzpedia.my.id/api/webhooks/qiospay"

# 2. WAROENGKUY RESELLER (Supplier Akun & Langganan Premium)
WAROENGKUY_ENABLED=true
WAROENGKUY_BASE_URL="https://waroengkuy.com/api/reseller/v1"
WAROENGKUY_API_KEY="wrk_your_api_key_here"
WAROENGKUY_TIMEOUT=15
WAROENGKUY_MARKUP_PERCENT=10
WAROENGKUY_PRICE_ROUNDING=500
WAROENGKUY_CATALOG_TTL=600

# 4. CUSTOMER SUPPORT
NEXT_PUBLIC_WHATSAPP_NUMBER="6281234567890"
NEXT_PUBLIC_CONTACT_EMAIL="dispute@xyzpedia.id"

# 5. ADMIN AUTHENTICATION
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="your_strong_password_here"
ADMIN_JWT_SECRET="generate_random_64_character_hex_string"
